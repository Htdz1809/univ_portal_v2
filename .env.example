# ---------------------------------------------------------------------------
# Docker Compose configuration (copy this file to .env before starting)
# ---------------------------------------------------------------------------
# PostgreSQL container credentials. Use an alphanumeric password so that the
# generated DATABASE_URL does not require URL-encoding.
POSTGRES_DB=university
POSTGRES_USER=university
POSTGRES_PASSWORD=ChangeMeStrongPassword2026
APP_PORT=3001
DB_PORT=5433

# ---------------------------------------------------------------------------
# Application configuration
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
# Used when the app runs outside Docker. Inside Compose, DATABASE_URL is built
# from the POSTGRES_* values and points at the "db" service.
DATABASE_URL=postgres://university:ChangeMeStrongPassword2026@localhost:5433/university
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-before-deploying

# Administrator account. The password is hashed in memory at startup; it is
# never stored in the database. For production, set a unique strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Administrator-2026!
# Optional: pre-computed bcrypt hash (takes precedence over ADMIN_PASSWORD).
# Generate with: npm run hash-password -- "your-password"
# ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash

# Session cookie behaviour: true / false / auto (default auto). "auto" marks
# the cookie Secure only when the request arrived over HTTPS.
# COOKIE_SECURE=auto

# Set to 1 when the app is behind a reverse proxy such as Render.
TRUST_PROXY=0
